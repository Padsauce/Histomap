{
  "name": "histomap",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Atlas historique interactif : carte du monde, frise adaptative et données Wikidata en temps réel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:index": "node tools/build-index.mjs --out public/index"
  },
  "dependencies": {
    "maplibre-gl": "5.6.0"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
